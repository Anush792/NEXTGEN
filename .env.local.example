# Copy this file to .env.local and set your OpenAI API key
# Example:
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Optional: choose model (gpt-4, gpt-3.5-turbo, etc.)
# OPENAI_MODEL=gpt-4
#
# NOTE: "No user limit" in the UI means the frontend imposes no hard cap, but external AI providers
# (OpenAI, etc.) enforce usage quotas, rate limits, and billing. Enabling unlimited usage requires
# an API plan and budget on the provider side — this project does not bypass provider limits.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Optional: Firebase Web SDK config to enable client-side logging of queries/responses
# Create a Firebase project (free tier) and add a Web app. Then set the following values in .env.local
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Hugging Face Inference API (alternative to OpenAI). Some models offer free tiers.
# HUGGINGFACE_API_KEY=hf_xxx
# HUGGINGFACE_MODEL=gpt2-large or other chat-capable model like 'tiiuae/falcon-7b-instruct' (check model inference compatibility)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
